# ============================================================
# Olist Streaming Pipeline — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO (S3-compatible Object Store) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist_warehouse
PG_USER=postgres
PG_PASSWORD=postgrespassword

# --- Producer Tuning ---
EVENTS_PER_SECOND=10        # Target throughput (events per second across all topics)

# --- Consumer Tuning ---
BATCH_SIZE=100              # Flush to MinIO + PG after N messages per topic
FLUSH_INTERVAL=30           # Flush every N seconds regardless of buffer size
